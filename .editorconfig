root = true

# Enforces the enforceable subset of the C# Coding Guidelines
# (https://csharpcodingguidelines.com/). The coding-guidelines CI job builds with
# these rules elevated to errors; fix the warnings locally or suppress them
# with a justification when a rule genuinely does not apply.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cs,csproj,slnx,props,targets}]
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
indent_style = space
trim_trailing_whitespace = true

[*.cs]
# AV1535: file-scoped namespaces; using directives outside the namespace
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# AV1121/AV1216: no this-qualification; use var when the type is apparent
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_elsewhere = false:silent

# AV1001/AV1135: modifier order per the C# spec defaults
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# AV1551/AV1552: modern language constructs
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
dotnet_style_explicit_tuple_names = true:warning
csharp_style_deconstructed_variable_declaration = true:silent
csharp_style_prefer_null_check_over_reference_check = true:silent
dotnet_style_prefer_auto_properties = true:silent
csharp_style_prefer_index_operator = true:silent
csharp_style_prefer_range_operator = true:silent
csharp_style_implicit_object_creation_when_type_is_apparent = true:silent

# AV1568: avoid blocking calls in async code (analyzer-backed rules)
dotnet_diagnostic.CS1998.severity = warning

# Naming (guidelines section "Naming"): types, members, and constants in
# PascalCase; interface names prefixed with I; locals and parameters in
# camelCase; private fields in _camelCase; constants in PascalCase
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, record
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.type_members.applicable_kinds = method, property, event
dotnet_naming_symbols.local_functions.applicable_kinds = local_function
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_styles.pascal_case.capitalization = pascal_case
dotnet_naming_styles.camel_case.capitalization = camel_case
dotnet_naming_styles.i_prefix_pascal_case.capitalization = pascal_case
dotnet_naming_styles.i_prefix_pascal_case.required_prefix = I
dotnet_naming_styles.underscore_camel_case.capitalization = camel_case
dotnet_naming_styles.underscore_camel_case.required_prefix = _

dotnet_naming_rule.types_pascal_case.symbols = types
dotnet_naming_rule.types_pascal_case.style = pascal_case
dotnet_naming_rule.types_pascal_case.severity = warning

dotnet_naming_rule.interfaces_i_prefixed_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefixed_pascal_case.style = i_prefix_pascal_case
dotnet_naming_rule.interfaces_i_prefixed_pascal_case.severity = warning

dotnet_naming_rule.type_members_pascal_case.symbols = type_members, local_functions
dotnet_naming_rule.type_members_pascal_case.style = pascal_case
dotnet_naming_rule.type_members_pascal_case.severity = warning

dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_rule.parameters_camel_case.severity = warning

dotnet_naming_rule.locals_camel_case.symbols = locals
dotnet_naming_rule.locals_camel_case.style = camel_case
dotnet_naming_rule.locals_camel_case.severity = warning

dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning

dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_rule.constants_pascal_case.severity = warning

# Unnecessary code: the codebase currently violates these broadly; the CI job
# fails until the cleanup pass removes them
dotnet_diagnostic.IDE0005.severity = warning

# Test method names use the xUnit underscore convention by design
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Justified deviations from the guidelines, scoped as narrowly as possible:
# CA1716: the shared wire-contract project is deliberately named Obicon.Shared;
#         the rule guards cross-language (VB) consumers, and this solution is C#-only
[src/Obicon.Shared/**]
dotnet_diagnostic.CA1716.severity = none

# CA1711: SqliteWriteQueue really is a queue of serialized write units; the
#         suffix rule guards System.Collections-style collection types
[src/Obicon.Server/Data/SqliteWriteQueue.cs]
dotnet_diagnostic.CA1711.severity = none

# CA5359: HTTP(S) tests deliberately accept any certificate - self-signed targets
#         are valid test targets, and TLS properties are reported in the result
[src/Obicon.Node/Services/TestRunners/HttpTestRunnerBase.cs]
dotnet_diagnostic.CA5359.severity = none
