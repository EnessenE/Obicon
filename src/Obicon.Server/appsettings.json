{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=obicon;Username=obicon;Password=obicon"
  },
  "Otlp": {
    "Endpoint": ""
  },
  "ServerSettings": {
    "AuthHeader": "secureobiconkey",
    "MaxTestTimeoutSeconds": 60,
    "NodeConnectionTimeoutSeconds": 30,
    "WebSocketPath": "/ws/nodes"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
